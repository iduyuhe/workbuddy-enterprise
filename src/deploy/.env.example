# ============================================================
# WorkBuddy Enterprise Edition - 环境变量示例
# 复制本文件为 .env 后按需修改：cp .env.example .env
# ============================================================

# ---- 模型路径与 vLLM ----
# 宿主机模型权重目录（docker-compose 中将 /models 挂载进 vllm 容器）
MODEL_PATH=/models/Qwen3-235B-A22B
# 推理服务地址（容器内 backend 访问用 http://vllm:8000）
VLLM_API_BASE=http://vllm:8000

# ---- 向量库 ----
QDRANT_URL=http://qdrant:6333

# ---- PostgreSQL ----
POSTGRES_USER=wbadmin
POSTGRES_PASSWORD=wbsecret
POSTGRES_DB=workbuddy

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- 鉴权 ----
JWT_SECRET=change-me-jwt-secret

# OIDC（企业 SSO，占位，部署时替换为真实值）
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_ISSUER=https://your-idp.example.com/realms/workbuddy

# ---- Langfuse（可观测） ----
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=pk-lf-dev
LANGFUSE_SECRET_KEY=sk-lf-dev
# Langfuse 内部 salt，生产请替换为随机值
LANGFUSE_SALT=change-me-salt

# ---- Grafana ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ---- 前端 ----
REACT_APP_API_BASE=http://localhost:8080
