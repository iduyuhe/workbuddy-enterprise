# ===== 数据库 =====
PG_USER=wb
PG_PASSWORD=changeme
PG_DB=workbuddy

# ===== JWT（RS256，建议用密钥管理生成并注入）=====
# 生成：openssl genrsa -out priv.pem 2048 && openssl rsa -in priv.pem -pubout -out pub.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ===== OIDC / SSO（企业 IdP，留空则用本地账号兜底）=====
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ===== 推理引擎 =====
VLLM_TP=8
VLLM_GPUS=8
SGLANG_GPUS=8
# Claude 可选（经 Bedrock/API，外网零外泄；默认不接）
CLAUDE_BASE_URL=

# ===== 密钥后端（vault / file）=====
SECRET_BACKEND=file

# ===== 审计留存（天）=====
AUDIT_RETENTION_DAYS=180

# ===== Langfuse =====
LANGFUSE_SALT=changeme
LANGFUSE_KEY=changeme
